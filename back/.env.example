MONGO_URL=mongodb://127.0.0.1:27017
# MongoDB hébergé (ex. Atlas) :
# MONGO_URL=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@VOTRE-CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=tgvmax
CORS_ORIGINS=http://localhost:3000

# Origines recalculées en parallèle après chaque sync (1 conseillé sur une petite machine, ~512 Mo).
# CACHE_WARM_CONCURRENCY=1

# Proxys de confiance devant l'API, pour la limite de requêtes par IP
# (1 : Vercel → uvicorn ; 2 : Vercel → nginx → uvicorn). Voir doc/deploiement.md.
# TRUSTED_PROXY_HOPS=0
